{% set actionNamespace = namespace ~ '\\TeBo\\Action' ~ (dir|length > 0 ? '\\' ~ dir : '') %}

{{ element('Bake.file_header', {
    namespace: actionNamespace,
    classImports: [
        'TeBo\\Action\\Action',
        'TeBo\\Action\\Command\\MessageCommandTrait',
        'TeBo\\Response\\HtmlMessage',
    ],
}) }}

/**
 * {{ (dir|length > 0 ? dir ~ '/' : '') ~ className }} action
 * This action is used to handle the /{{ teboCommand }} command.
 */
class {{ className }}Action extends Action
{
    use MessageCommandTrait;

    /**
     * @return void
     */
    public function initialize(): void
    {
        parent::initialize();
    }

    /**
     * The command description for the help action.
     *
     * @return string|null
     */
    public function description(): ?string
    {
        return __('{{ teboCommand }} action.');
    }

    /**
     * Execute the action.
     * 
     * @return void
     */
    public function execute(): void
    {
        // add this action to the command list in config/tebo.php
        // 'actions' => [
        //     '{{ teboCommand }}' => \{{ actionNamespace }}\{{ className }}Action::class,
        // ]

        $message = new HtmlMessage(__('Hello, I am <code>/{{ teboCommand }}</code> action.'));
        $this->getChat()->send($message);
    }
}
