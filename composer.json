{
    "name": "arodu/tebo",
    "description": "TeBo plugin for CakePHP",
    "type": "cakephp-plugin",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "cakephp/cakephp": "5.1.*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.1"
    },
    "autoload": {
        "psr-4": {
            "TeBo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TeBo\\Test\\": "tests/",
            "Cake\\Test\\": "vendor/cakephp/cakephp/tests/"
        }
    }
}
